pipeline {
    agent any

    stages {
        stage('Unit Tests - Backend') {
                agent {
                    docker{
                        image 'golang:1.21'
                        reuseNode true 
                    }
                }
                steps {
                dir('bugtracker-backend') {
                    sh 'HOME=/tmp GOCACHE=/tmp/go-build GOPATH=/tmp/go go test -v ./...'
                }
            }
        }

        stage('Unit Tests - Frontend') {
                agent {
                    docker{
                        image 'node:20-alpine'
                        reuseNode true 
                    }
                }
                steps {
                dir('bugtracker-frontend') {
                    sh '''
                    npm ci
                    npm test
                    '''
                }
            }
            post {
                always {
                    junit 'bugtracker-frontend/test-results.xml'
                }
            }
        }
    }
}